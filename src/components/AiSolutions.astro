---
<section id="ia" class="ia theme-dark py-section" aria-labelledby="h-ia">
  <div class="ia__bg" aria-hidden="true"><span class="ia__blob ia__blob--1"></span><span class="ia__blob ia__blob--2"></span><span class="ia__blob ia__blob--3"></span></div>
  <div class="container-wide relative">
    <header class="text-center" data-reveal>
      <p class="badge-pill">Inteligencia artificial</p>
      <h2 id="h-ia" class="mx-auto mt-4 max-w-[22ch] text-display text-ink">Soluciones con IA para hacer <span class="accent-word">crecer tu negocio</span></h2>
      <p class="mx-auto mt-4 max-w-text text-lead text-ink-secondary" data-sweep>Automatizamos las tareas repetitivas para que atiendas más clientes sin perder el trato personal.</p>
    </header>
    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" role="list">
      {cards.map((c, i) => (
        <li data-reveal style={`--reveal-i:${i % 4}`}>
          <article class="glass" data-tilt>
            <div class="flex items-start justify-between gap-3">
              <span class="glass__icon"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={c.i} /></svg></span>
              {c.b && <span class="glass__badge">Bajo consulta</span>}
            </div>
            <div class="illus" aria-hidden="true"><svg viewBox="0 0 200 100" set:html={illus[i]} /></div>
            <h3 class="mt-4 text-title text-ink">{c.t}</h3>
            <p class="mt-2 text-body text-ink-secondary" data-sweep>{c.d}</p>
          </article>
        </li>
      ))}
    </ul>
    <div class="mt-12 flex justify-center" data-reveal>
      <WhatsAppButton message="ia" label="Quiero automatizar mi negocio" />
    </div>
  </div>
</section>

<style>
  /* Dark glass look modeled on @astroanimate/core GlassCard (container #111722, card #232933), rebuilt here because GlassCard has no slot. */
  .ia { position: relative; overflow: hidden; isolation: isolate; background: #111722; }
  .ia__bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .ia__blob { position: absolute; width: 38rem; height: 38rem; border-radius: 50%; filter: blur(80px); opacity: .32; }
  .ia__blob--1 { background: radial-gradient(circle, #6366f1 0%, transparent 65%); top: -10rem; left: -8rem; }
  .ia__blob--2 { background: radial-gradient(circle, #8b5cf6 0%, transparent 65%); top: 30%; right: -12rem; opacity: .25; }
  .ia__blob--3 { background: radial-gradient(circle, #22d3ee 0%, transparent 65%); bottom: -14rem; left: 30%; opacity: .12; }

  .glass {
    --mx: 50%; --my: 0%; --rx: 0deg; --ry: 0deg;
    position: relative; height: 100%; padding: 1.5rem; border-radius: 1.5rem;
    background: linear-gradient(160deg, rgb(35 41 51 / .78), rgb(35 41 51 / .5));
    backdrop-filter: blur(20px) saturate(140%); -webkit-backdrop-filter: blur(20px) saturate(140%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / .08), 0 25px 50px -12px rgb(0 0 0 / .45);
    transform: perspective(1000px) rotateX(var(--rx)) rotateY(var(--ry)) scale(var(--sc, 1));
    transition: transform .15s ease-out, box-shadow .4s ease;
  }
  /* Refraction-like gradient border */
  .glass::before {
    content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 1px; pointer-events: none;
    background: linear-gradient(135deg, rgb(255 255 255 / .28), rgb(139 92 246 / .3) 35%, rgb(255 255 255 / .08) 65%, rgb(165 180 252 / .25));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude;
  }
  /* Soft specular highlight that follows the pointer */
  .glass::after {
    content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; opacity: 0; transition: opacity .4s ease;
    background: radial-gradient(circle at var(--mx) var(--my), rgb(255 255 255 / .15) 0%, transparent 50%);
  }
  .glass > * { position: relative; z-index: 1; }
  .glass__icon { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; color: #fff;
    background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); box-shadow: 0 10px 15px -3px rgb(99 102 241 / .4); }
  .glass__badge { font-size: .75rem; font-weight: 600; line-height: 1; padding: .45rem .7rem; border-radius: 999px; color: #c7d2fe; white-space: nowrap;
    background: rgb(99 102 241 / .16); box-shadow: inset 0 0 0 1px rgb(165 180 252 / .3); }

  @media (hover: hover) and (pointer: fine) {
    .glass:hover { box-shadow: inset 0 1px 0 rgb(255 255 255 / .12), 0 0 0 1px rgb(165 180 252 / .25), 0 25px 50px -12px rgb(0 0 0 / .5), 0 0 40px -10px rgb(99 102 241 / .45); }
    .glass:hover::after { opacity: 1; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .ia__blob--1 { animation: ia-drift 22s ease-in-out infinite alternate; }
    .ia__blob--2 { animation: ia-drift 26s ease-in-out -8s infinite alternate-reverse; }
    .ia__blob--3 { animation: ia-drift 30s ease-in-out -4s infinite alternate; }
  }
  @keyframes ia-drift { from { transform: translate3d(0,0,0) scale(1); } to { transform: translate3d(6rem,4rem,0) scale(1.15); } }
  @media (max-width: 767px) {
    .ia__blob { width: 22rem; height: 22rem; filter: blur(60px); animation: none !important; }
    .glass { backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  }

  /* Card illustrations: final frame by default; .glass:hover (pointer) or .glass.play (touch, once in view) replays them. */
  .illus { margin-top: 1rem; height: 6.25rem; border-radius: 1rem; display: grid; place-items: center;
    background: linear-gradient(160deg, rgb(17 23 34 / .55), rgb(99 102 241 / .10)); box-shadow: inset 0 1px 0 rgb(255 255 255 / .06), inset 0 0 0 1px rgb(165 180 252 / .12); }
  .illus svg { width: 100%; height: 100%; }
  .illus :global(.a) { transform-box: fill-box; transform-origin: center; }
  .illus :global(.pr) { transform-origin: right bottom; }
  .illus :global(.grow) { transform-origin: bottom; }
  .illus :global(.grow-x) { transform-origin: left; }
  .illus :global(.draw) { stroke-dasharray: 120; stroke-dashoffset: 0; }
  @media (prefers-reduced-motion: no-preference) {
    @media (hover: hover) and (pointer: fine) {
      .glass:hover .illus :global(.pop) { animation: il-pop .5s cubic-bezier(.3,1.5,.5,1) var(--d,0ms) both; }
      .glass:hover .illus :global(.draw) { animation: il-draw .6s ease var(--d,0ms) both; }
      .glass:hover .illus :global(.grow) { animation: il-grow .6s cubic-bezier(.2,.8,.2,1) var(--d,0ms) both; }
      .glass:hover .illus :global(.grow-x) { animation: il-grow-x .7s cubic-bezier(.2,.8,.2,1) var(--d,0ms) both; }
      .glass:hover .illus :global(.ring) { animation: il-ring .9s ease-in-out var(--d,0ms) both; }
      .glass:hover .illus :global(.wave) { animation: il-wave 1s ease-out var(--d,0ms) both; }
      .glass:hover .illus :global(.blink) { animation: il-blink 1s ease-in-out var(--d,0ms) 2 both; }
      .glass:hover .illus :global(.slide) { animation: il-slide .6s cubic-bezier(.2,.8,.2,1) var(--d,0ms) both; }
    }
    .glass.play .illus :global(.pop) { animation: il-pop .5s cubic-bezier(.3,1.5,.5,1) var(--d,0ms) both; }
    .glass.play .illus :global(.draw) { animation: il-draw .6s ease var(--d,0ms) both; }
    .glass.play .illus :global(.grow) { animation: il-grow .6s cubic-bezier(.2,.8,.2,1) var(--d,0ms) both; }
    .glass.play .illus :global(.grow-x) { animation: il-grow-x .7s cubic-bezier(.2,.8,.2,1) var(--d,0ms) both; }
    .glass.play .illus :global(.ring) { animation: il-ring .9s ease-in-out var(--d,0ms) both; }
    .glass.play .illus :global(.wave) { animation: il-wave 1s ease-out var(--d,0ms) both; }
    .glass.play .illus :global(.blink) { animation: il-blink 1s ease-in-out var(--d,0ms) 2 both; }
    .glass.play .illus :global(.slide) { animation: il-slide .6s cubic-bezier(.2,.8,.2,1) var(--d,0ms) both; }
  }
  @keyframes il-pop { from { opacity: 0; transform: scale(.4); } to { opacity: 1; transform: none; } }
  @keyframes il-draw { from { stroke-dashoffset: 120; } to { stroke-dashoffset: 0; } }
  @keyframes il-grow { from { transform: scaleY(0); } to { transform: none; } }
  @keyframes il-grow-x { from { transform: scaleX(0); } to { transform: none; } }
  @keyframes il-ring { 0%,100% { transform: none; } 15% { transform: rotate(-12deg); } 30% { transform: rotate(10deg); } 45% { transform: rotate(-8deg); } 60% { transform: rotate(6deg); } 75% { transform: rotate(-3deg); } }
  @keyframes il-wave { from { opacity: 0; transform: scale(.6); } 60% { opacity: 1; } to { opacity: 1; transform: none; } }
  @keyframes il-blink { 0%,100% { opacity: 1; transform: none; } 50% { opacity: .3; transform: translateY(-3px); } }
  @keyframes il-slide { from { opacity: 0; transform: translateX(24px) rotate(6deg); } to { opacity: 1; transform: none; } }

  /* Line-by-line color sweep (JS adds .sweep-on; without JS or with reduced motion the text keeps its normal color) */
  :global(.sweep-on .sw) { color: var(--sw-c, inherit); }
  @media (prefers-reduced-motion: reduce) { .glass { transition: none; transform: none; } }
</style>

<script>
  // Touch devices: play each card's illustration once when it scrolls into view.
  if (!matchMedia("(hover: hover) and (pointer: fine)").matches && !matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("play"); io.unobserve(e.target); } }), { threshold: 0.5 });
    document.querySelectorAll("#ia .glass").forEach((el) => io.observe(el));
  }

  // Text sweep: muted gray → brand purple → final ink, line by line, tied to scroll progress.
  // Words are wrapped once; line indexes are recomputed on resize. Off with reduced motion.
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const blocks = [...document.querySelectorAll<HTMLElement>("#ia [data-sweep]")];
    // Resolve theme colors to rgb via a probe (works whatever format the CSS variables use).
    const probe = document.createElement("span"); (blocks[0] || document.body).append(probe);
    const rgb = (c: string) => { probe.style.color = c; return (getComputedStyle(probe).color.match(/[\d.]+/g) || ["0", "0", "0"]).slice(0, 3).map(Number); };
    const MUTED = rgb("#4b5263"), BRAND = rgb("var(--accent)"), FINAL0 = rgb("var(--ink-secondary)");
    probe.remove();
    // Final color: body gray with a soft brand-purple tint (still well above AA on the canvas).
    const FINAL = FINAL0.map((x, i) => Math.round(x + (BRAND[i] - x) * 0.3));
    const mix = (a: number[], b: number[], t: number) => `rgb(${a.map((x, i) => Math.round(x + (b[i] - x) * t)).join(",")})`;
    const colorAt = (p: number) => (p <= 0 ? mix(MUTED, MUTED, 0) : p < 0.5 ? mix(MUTED, BRAND, p / 0.5) : mix(BRAND, FINAL, (p - 0.5) / 0.5));
    type W = { el: HTMLElement; line: number; x: number; last: string };
    const data = blocks.map((b) => {
      const words = (b.textContent || "").trim().split(/\s+/);
      b.textContent = "";
      const ws: W[] = words.map((w, i) => { const s = document.createElement("span"); s.className = "sw"; s.textContent = w; s.style.setProperty("--sw-c", colorAt(0)); b.append(s); if (i < words.length - 1) b.append(" "); return { el: s, line: 0, x: 0, last: colorAt(0) }; });
      b.classList.add("sweep-on");
      return { b, ws, lines: 1 };
    });
    const measure = () => data.forEach((d) => {
      let top = -1, line = -1; const rows: W[][] = [];
      d.ws.forEach((w) => { const t = w.el.offsetTop; if (Math.abs(t - top) > 2) { top = t; line++; rows.push([]); } w.line = line; rows[line].push(w); });
      rows.forEach((r) => { const l = r[0].el.offsetLeft, wd = Math.max(1, r[r.length - 1].el.offsetLeft + r[r.length - 1].el.offsetWidth - l); r.forEach((w) => (w.x = (w.el.offsetLeft - l) / wd)); });
      d.lines = rows.length;
    });
    let raf = 0;
    const paint = () => {
      raf = 0; const vh = innerHeight;
      data.forEach((d) => {
        const r = d.b.getBoundingClientRect();
        if (r.bottom < -200 || r.top > vh + 200) return;
        // 0 when the block's top is at 92% of the viewport, 1 when it reaches 45%.
        const bp = Math.min(1, Math.max(0, (vh * 0.92 - r.top) / (vh * 0.47)));
        d.ws.forEach((w) => {
          const lp = bp * (d.lines + 0.8) - w.line * 0.85;          // staggered per line
          const p = Math.min(1, Math.max(0, lp * 0.9 - w.x * 0.35)); // sweep left → right inside the line
          const c = colorAt(p); if (c !== w.last) { w.el.style.setProperty("--sw-c", c); w.last = c; }
        });
      });
    };
    const req = () => { if (!raf) raf = requestAnimationFrame(paint); };
    measure(); paint();
    addEventListener("scroll", req, { passive: true });
    let rt = 0; addEventListener("resize", () => { clearTimeout(rt); rt = window.setTimeout(() => { measure(); req(); }, 120); });
    document.fonts?.ready.then(() => { measure(); req(); });
  }

  // Hover tilt + glow: pointer devices only, off with reduced motion.
  if (matchMedia("(hover: hover) and (pointer: fine)").matches && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((el) => {
      let raf = 0;
      el.addEventListener("pointermove", (e) => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const r = el.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
          el.style.setProperty("--sc", "1.02"); el.style.setProperty("--mx", `${x * 100}%`); el.style.setProperty("--my", `${y * 100}%`);
          el.style.setProperty("--ry", `${(x - 0.5) * 20}deg`); el.style.setProperty("--rx", `${(0.5 - y) * 20}deg`);
        });
      });
      el.addEventListener("pointerleave", () => { cancelAnimationFrame(raf); el.style.setProperty("--rx", "0deg"); el.style.setProperty("--ry", "0deg"); el.style.setProperty("--sc", "1"); });
    });
  }
</script>
