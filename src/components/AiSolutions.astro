  { t: "Chatbot para tu página web", d: "Entrenado con la información de tu negocio.", i: "M12 8V4H8M4 8h16v12H4zM2 14h2M20 14h2M9 13v2M15 13v2" },
  { t: "Catálogo conectado a WhatsApp", d: "Con enlaces de pago (Wompi/Bold).", b: true, i: "M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4zM3 6h18M16 10a4 4 0 0 1-8 0" },
  { t: "Reporte mensual simple", d: "Leads, llamadas y citas.", i: "M3 3v18h18M7 16v-4M12 16V8M17 16v-7" },
