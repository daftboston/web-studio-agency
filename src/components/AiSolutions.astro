\"#1b2130\" stroke=\"#3a4158\" stroke-width=\"1.5\"/><rect x=\"39\" y=\"55\" width=\"16\" height=\"14\" rx=\"2\" fill=\"#2c3150\"/><rect x=\"39\" y=\"73\" width=\"12\" height=\"3\" rx=\"1.5\" fill=\"#3a4158\"/></g><g class=\"a pop\" style=\"--d:280ms\"><rect x=\"62\" y=\"52\" width=\"22\" height=\"32\" rx=\"4\" fill=\"#1b2130\" stroke=\"#3a4158\" stroke-width=\"1.5\"/><rect x=\"65\" y=\"55\" width=\"16\" height=\"14\" rx=\"2\" fill=\"#2c3150\"/><rect x=\"65\" y=\"73\" width=\"12\" height=\"3\" rx=\"1.5\" fill=\"#3a4158\"/></g><g class=\"a pop\" style=\"--d:350ms\"><rect x=\"88\" y=\"52\" width=\"22\" height=\"32\" rx=\"4\" fill=\"#1b2130\" stroke=\"#3a4158\" stroke-width=\"1.5\"/><rect x=\"91\" y=\"55\" width=\"16\" height=\"14\" rx=\"2\" fill=\"#2c3150\"/><rect x=\"91\" y=\"73\" width=\"12\" height=\"3\" rx=\"1.5\" fill=\"#3a4158\"/></g>\n<g class=\"a slide\" style=\"--d:450ms\"><rect x=\"122\" y=\"30\" width=\"56\" height=\"36\" rx=\"6\" fill=\"var(--accent)\"/><rect x=\"122\" y=\"38\" width=\"56\" height=\"7\" fill=\"#2b28a8\"/><rect x=\"128\" y=\"52\" width=\"20\" height=\"4\" rx=\"2\" fill=\"#ffffff\" opacity=\".8\"/></g>\n<circle cx=\"174\" cy=\"68\" r=\"10\" fill=\"#1b2130\" stroke=\"var(--accent)\" stroke-width=\"2\" class=\"a pop\" style=\"--d:800ms\"/><path d=\"m169 68 4 4 6-7\" stroke=\"var(--accent)\" stroke-width=\"2.5\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"a draw\" style=\"--d:950ms\"/>", "<path d=\"M44 84h120\" stroke=\"#3a4158\" stroke-width=\"2\"/><rect x=\"56\" y=\"62\" width=\"14\" height=\"22\" rx=\"3\" fill=\"#2c3150\" class=\"a grow\" style=\"--d:0ms\"/><rect x=\"80\" y=\"50\" width=\"14\" height=\"34\" rx=\"3\" fill=\"#2c3150\" class=\"a grow\" style=\"--d:110ms\"/><rect x=\"104\" y=\"56\" width=\"14\" height=\"28\" rx=\"3\" fill=\"#2c3150\" class=\"a grow\" style=\"--d:220ms\"/><rect x=\"128\" y=\"36\" width=\"14\" height=\"48\" rx=\"3\" fill=\"#2c3150\" class=\"a grow\" style=\"--d:330ms\"/><rect x=\"152\" y=\"22\" width=\"14\" height=\"62\" rx=\"3\" fill=\"var(--accent)\" class=\"a grow\" style=\"--d:440ms\"/>\n<path d=\"M63 58l24-12 24 6 24-20 24-14\" stroke=\"var(--accent)\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"a draw\" style=\"--d:500ms\"/>"];
const cards = [
  { t: "Asistente de WhatsApp con IA", d: "Responde preguntas frecuentes, horarios y precios las 24 horas, y te pasa la conversación cuando el cliente lo necesita.", i: "M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.5 8.5 0 1 1 21 11.5z" },
  { t: "Contestador de llamadas con voz IA", d: "Atiende llamadas, toma el mensaje o resuelve lo básico cuando no puedes contestar.", b: true, i: "M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" },
  { t: "Agendamiento automático", d: "Tus clientes reservan citas desde WhatsApp o tu página, con recordatorios para reducir inasistencias.", b: true, i: "M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" },
