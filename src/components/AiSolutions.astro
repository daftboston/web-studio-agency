---
/** Home: "Soluciones con IA" (2026-10-20). Liquid-glass cards. Exact copy approved; no prices, no promised results. */
import WhatsAppButton from "./WhatsAppButton.astro";
const cards = [
  { t: "Asistente de WhatsApp con IA", d: "Responde preguntas frecuentes, horarios y precios las 24 horas, y te pasa la conversación cuando el cliente lo necesita.", i: "M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.5 8.5 0 1 1 21 11.5z" },
  { t: "Contestador de llamadas con voz IA", d: "Atiende llamadas, toma el mensaje o resuelve lo básico cuando no puedes contestar.", b: true, i: "M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" },
  { t: "Agendamiento automático", d: "Tus clientes reservan citas desde WhatsApp o tu página, con recordatorios para reducir inasistencias.", b: true, i: "M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" },
  { t: "Reseñas en Google con IA", d: "QR para pedir reseñas a clientes satisfechos y respuestas sugeridas con IA.", i: "m12 3 2.8 5.7 6.2.9-4.5 4.4 1 6.2L12 17.3 6.5 20.2l1-6.2L3 9.6l6.2-.9L12 3z" },
  { t: "Seguimiento automático de clientes", d: "Recordatorios a contactos que no agendaron.", i: "M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0" },
  { t: "Chatbot para tu página web", d: "Entrenado con la información de tu negocio.", i: "M12 8V4H8M4 8h16v12H4zM2 14h2M20 14h2M9 13v2M15 13v2" },
  { t: "Catálogo conectado a WhatsApp", d: "Con enlaces de pago (Wompi/Bold).", b: true, i: "M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4zM3 6h18M16 10a4 4 0 0 1-8 0" },
  { t: "Reporte mensual simple", d: "Leads, llamadas y citas.", i: "M3 3v18h18M7 16v-4M12 16V8M17 16v-7" },
];
---
<section id="ia" class="ia bg-canvas py-section" aria-labelledby="h-ia">
  <div class="ia__bg" aria-hidden="true"><span class="ia__blob ia__blob--1"></span><span class="ia__blob ia__blob--2"></span><span class="ia__blob ia__blob--3"></span></div>
  <div class="container-wide relative">
    <header class="text-center" data-reveal>
      <p class="badge-pill">Inteligencia artificial</p>
      <h2 id="h-ia" class="mx-auto mt-4 max-w-[22ch] text-display text-ink">Soluciones con IA para hacer <span class="accent-word">crecer tu negocio</span></h2>
      <p class="mx-auto mt-4 max-w-text text-lead text-ink-secondary">Automatizamos las tareas repetitivas para que atiendas más clientes sin perder el trato personal.</p>
    </header>
    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" role="list">
      {cards.map((c, i) => (
        <li data-reveal style={`--reveal-i:${i % 4}`}>
          <article class="glass" data-tilt>
            <div class="flex items-start justify-between gap-3">
              <span class="glass__icon"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={c.i} /></svg></span>
              {c.b && <span class="glass__badge">Bajo consulta</span>}
            </div>
            <h3 class="mt-5 text-title text-ink">{c.t}</h3>
            <p class="mt-2 text-body text-ink-secondary">{c.d}</p>
          </article>
        </li>
      ))}
    </ul>
    <div class="mt-12 flex justify-center" data-reveal>
      <WhatsAppButton message="ia" label="Quiero automatizar mi negocio" />
    </div>
  </div>
</section>

<style>
  .ia { position: relative; overflow: hidden; isolation: isolate; }
  .ia__bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .ia__blob { position: absolute; width: 38rem; height: 38rem; border-radius: 50%; filter: blur(80px); opacity: .45; }
  .ia__blob--1 { background: radial-gradient(circle, #8b88ff 0%, transparent 65%); top: -10rem; left: -8rem; }
  .ia__blob--2 { background: radial-gradient(circle, #5ee6c4 0%, transparent 65%); top: 30%; right: -12rem; opacity: .35; }
  .ia__blob--3 { background: radial-gradient(circle, #ffb3d9 0%, transparent 65%); bottom: -14rem; left: 30%; opacity: .3; }

  .glass {
    --mx: 50%; --my: 0%; --rx: 0deg; --ry: 0deg;
    position: relative; height: 100%; padding: 1.5rem; border-radius: 1.5rem;
    background: linear-gradient(160deg, rgb(255 255 255 / .72), rgb(255 255 255 / .38));
    backdrop-filter: blur(18px) saturate(160%); -webkit-backdrop-filter: blur(18px) saturate(160%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / .9), 0 1px 2px rgb(20 20 40 / .04), 0 12px 32px -12px rgb(40 40 90 / .18);
    transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform .4s cubic-bezier(.2,.8,.2,1), box-shadow .4s ease;
  }
  /* Refraction-like gradient border */
  .glass::before {
    content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 1px; pointer-events: none;
    background: linear-gradient(135deg, rgb(255 255 255 / .95), rgb(139 136 255 / .45) 35%, rgb(94 230 196 / .35) 65%, rgb(255 255 255 / .8));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude;
  }
  /* Soft specular highlight that follows the pointer */
  .glass::after {
    content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; opacity: 0; transition: opacity .4s ease;
    background: radial-gradient(22rem circle at var(--mx) var(--my), rgb(255 255 255 / .55), rgb(139 136 255 / .12) 40%, transparent 65%);
  }
  .glass > * { position: relative; z-index: 1; }
  .glass__icon { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: .875rem; color: var(--accent);
    background: linear-gradient(140deg, rgb(255 255 255 / .9), rgb(139 136 255 / .18)); box-shadow: inset 0 1px 0 #fff, 0 4px 12px -4px rgb(61 58 214 / .35); }
  .glass__badge { font-size: .75rem; font-weight: 600; line-height: 1; padding: .45rem .7rem; border-radius: 999px; color: var(--accent); white-space: nowrap;
    background: rgb(255 255 255 / .6); box-shadow: inset 0 0 0 1px rgb(61 58 214 / .2); backdrop-filter: blur(8px); }

  @media (hover: hover) and (pointer: fine) {
    .glass:hover { box-shadow: inset 0 1px 0 #fff, 0 0 0 1px rgb(139 136 255 / .25), 0 24px 48px -16px rgb(61 58 214 / .35); }
    .glass:hover::after { opacity: 1; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .ia__blob--1 { animation: ia-drift 22s ease-in-out infinite alternate; }
    .ia__blob--2 { animation: ia-drift 26s ease-in-out -8s infinite alternate-reverse; }
    .ia__blob--3 { animation: ia-drift 30s ease-in-out -4s infinite alternate; }
  }
  @keyframes ia-drift { from { transform: translate3d(0,0,0) scale(1); } to { transform: translate3d(6rem,4rem,0) scale(1.15); } }
  @media (max-width: 767px) {
    .ia__blob { width: 22rem; height: 22rem; filter: blur(60px); animation: none !important; }
    .glass { backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  }
  @media (prefers-reduced-motion: reduce) { .glass { transition: none; transform: none; } }
</style>

<script>
  // Hover tilt + glow: pointer devices only, off with reduced motion.
  if (matchMedia("(hover: hover) and (pointer: fine)").matches && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((el) => {
      let raf = 0;
      el.addEventListener("pointermove", (e) => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const r = el.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
          el.style.setProperty("--mx", `${x * 100}%`); el.style.setProperty("--my", `${y * 100}%`);
          el.style.setProperty("--ry", `${(x - 0.5) * 8}deg`); el.style.setProperty("--rx", `${(0.5 - y) * 8}deg`);
        });
      });
      el.addEventListener("pointerleave", () => { cancelAnimationFrame(raf); el.style.setProperty("--rx", "0deg"); el.style.setProperty("--ry", "0deg"); });
    });
  }
</script>
