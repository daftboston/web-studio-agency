const illus: string[] = ["<rect x=\"38\" y=\"10\" width=\"124\" height=\"80\" rx=\"12\" fill=\"#1b2130\" opacity=\".9\"/>\n<g class=\"a pop\" style=\"--d:0ms\"><rect x=\"50\" y=\"20\" width=\"62\" height=\"16\" rx=\"8\" fill=\"#2f3646\"/><rect x=\"58\" y=\"26\" width=\"40\" height=\"4\" rx=\"2\" fill=\"#6b7385\"/></g>\n<g class=\"a pop pr\" style=\"--d:250ms\"><rect x=\"96\" y=\"42\" width=\"56\" height=\"16\" rx=\"8\" fill=\"#25D366\"/><rect x=\"104\" y=\"48\" width=\"36\" height=\"4\" rx=\"2\" fill=\"#ffffff\"/></g>\n<g class=\"a pop\" style=\"--d:500ms\"><rect x=\"50\" y=\"64\" width=\"72\" height=\"16\" rx=\"8\" fill=\"#2f3646\"/><rect x=\"58\" y=\"70\" width=\"52\" height=\"4\" rx=\"2\" fill=\"#6b7385\"/></g>\n<circle cx=\"146\" cy=\"72\" r=\"9\" fill=\"#25D366\" class=\"a pop\" style=\"--d:750ms\"/><path d=\"m142 72 3 3 5-6\" stroke=\"#ffffff\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" class=\"a draw\" style=\"--d:900ms\"/>", "<g class=\"a ring\" style=\"--d:0ms\"><rect x=\"84\" y=\"18\" width=\"32\" height=\"64\" rx=\"8\" fill=\"#1b2130\" stroke=\"var(--accent)\" stroke-width=\"2.5\"/><rect x=\"90\" y=\"26\" width=\"20\" height=\"40\" rx=\"3\" fill=\"#2c3150\"/><circle cx=\"100\" cy=\"73\" r=\"2.5\" fill=\"var(--accent)\"/></g>\n<path d=\"M126 38a16 16 0 0 1 0 24\" class=\"a wave\" style=\"--d:150ms\" stroke=\"var(--accent)\" stroke-width=\"2.5\" fill=\"none\" stroke-linecap=\"round\"/>\n<path d=\"M134 30a28 28 0 0 1 0 40\" class=\"a wave\" style=\"--d:350ms\" stroke=\"var(--accent)\" stroke-width=\"2.5\" fill=\"none\" stroke-linecap=\"round\" opacity=\".6\"/>\n<path d=\"M74 38a16 16 0 0 0 0 24\" class=\"a wave\" style=\"--d:150ms\" stroke=\"var(--accent)\" stroke-width=\"2.5\" fill=\"none\" stroke-linecap=\"round\"/>\n<path d=\"M66 30a28 28 0 0 0 0 40\" class=\"a wave\" style=\"--d:350ms\" stroke=\"var(--accent)\" stroke-width=\"2.5\" fill=\"none\" stroke-linecap=\"round\" opacity=\".6\"/>", "<rect x=\"56\" y=\"14\" width=\"88\" height=\"74\"