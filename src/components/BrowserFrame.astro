---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
  class?: string;
  /** Crop to one fixed ratio (top-aligned) so portfolio tiles line up. */
  crop?: boolean;
}
const { src, alt, widths = [480, 800, 1280], sizes = "(min-width: 1024px) 50vw, 100vw", eager = false, class: cls = "", crop = false } = Astro.props;
---
<div class:list={["browser-frame", cls]}>
  <div class="bf-bar" aria-hidden="true"><span class="bf-dot"></span><span class="bf-dot"></span><span class="bf-dot"></span></div>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    format="webp"
    quality={78}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : undefined}
    class:list={["block w-full", crop ? "aspect-[32/17] object-cover object-top" : "h-auto"]}
  />
</div>
