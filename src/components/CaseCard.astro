---
/** Featured-work card (Clay pattern): big cropped image that zooms on arrival and hover, name, outcome headline, tags. */
import type { Project } from "../data/portfolio";
import { Image } from "astro:assets";
interface Props { project: Project; index?: number; class?: string; aspect?: string }
const { project, index = 0, class: cls = "", aspect = "aspect-[4/3]" } = Astro.props;
---
<a href={`/portafolio/#${project.id}`} class:list={["case-card group block", cls]} data-reveal style={`--reveal-i:${index}`}>
  <div class:list={["media-clip relative rounded-tile bg-surface-2", aspect]} data-zoom>
    <Image src={project.image} alt="" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 820px, 125vw" format="webp" quality={78} loading="lazy" class="absolute left-[7%] top-[11%] w-[128%] max-w-none rounded-tl-[14px] shadow-lift ring-1 ring-line" />
    <div class="absolute bottom-0 right-[7%] w-[27%] translate-y-[14%]" aria-hidden="true" data-parallax style="--depth:24">
      <div class="phone-frame !rounded-[1.6rem] !p-[0.35rem] md:!rounded-[2rem]"><div class="pf-screen !rounded-[1.3rem] md:!rounded-[1.65rem]">
        <Image src={project.phone.src} alt="" widths={[200, 320]} sizes="(min-width: 1024px) 170px, 26vw" format="webp" quality={72} loading="lazy" class="block h-auto w-full" />
      </div></div>
    </div>
  </div>
  <div class="mt-5 flex items-start justify-between gap-6">
    <div>
      <h3 class="text-title text-ink">{project.name}</h3>
      <p class="mt-1 text-body text-ink-secondary">{project.headline}</p>
      <ul class="mt-4 flex flex-wrap gap-2" role="list" aria-label={`Etiquetas de ${project.name}`}>
        {project.tags.map((t) => <li class="tag">{t}</li>)}
      </ul>
    </div>
    <span class="case-arrow mt-1 text-title text-ink-tertiary" aria-hidden="true">→</span>
  </div>
  <span class="sr-only">Ver el caso {project.name}</span>
</a>
