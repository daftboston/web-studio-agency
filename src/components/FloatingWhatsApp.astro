---
import { waLink } from "../config";
import WaIcon from "./WaIcon.astro";
---
<a
  href={waLink()}
  target="_blank"
  rel="noopener"
  class="fab-whatsapp fab-enter"
  aria-label="Escríbenos por WhatsApp"
  data-fab
>
  <WaIcon size={28} class="lg:hidden" />
  <WaIcon size={20} class="hidden lg:block" />
  <span class="hidden text-[1.0625rem] font-semibold lg:inline">WhatsApp</span>
</a>
