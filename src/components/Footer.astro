---
import { CONTACT, NAV_LINKS, waLink } from "../config";
import Wordmark from "./Wordmark.astro";
const year = new Date().getFullYear();
interface Props { scene?: string }
const { scene } = Astro.props;
const services = ["Página web", "Catálogo en línea", "Landing + campaña", "Digital Care", "Growth", "Automatización de clientes"];
---
<footer class="bg-surface pt-section-tight pb-24 lg:pb-section-tight" data-scene={scene}>
  <div class="container-content">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div>
        <Wordmark size="footer" />
        <p class="mt-3 text-caption text-ink-secondary">Páginas web para negocios.</p>
        <p class="mt-1 text-caption text-ink-secondary">Más de 3 años de experiencia creando sitios web.</p>
      </div>
      <div>
        <h2 class="text-caption font-semibold text-ink">Servicios</h2>
        <ul class="mt-3 space-y-2 text-caption text-ink-secondary" role="list">
          {services.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="text-caption font-semibold text-ink">Enlaces</h2>
        <ul class="mt-3 space-y-2 text-caption" role="list">
          {NAV_LINKS.map((l) => <li><a class="text-ink-secondary hover:text-ink" href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="text-caption font-semibold text-ink">Contacto y legal</h2>
        <ul class="mt-3 space-y-2 text-caption text-ink-secondary" role="list">
          <li><a class="hover:text-ink" href={waLink()} target="_blank" rel="noopener">WhatsApp {CONTACT.whatsappDisplay}</a></li>
          <li><a class="hover:text-ink" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
          <li><a class="hover:text-ink" href="/privacidad/">Política de privacidad (Ley 1581)</a></li>
          <li><a class="hover:text-ink" href="/terminos/">Términos</a></li>
        </ul>
      </div>
    </div>
    <p class="mt-12 border-t border-line pt-6 text-micro text-ink-tertiary">Filmika · Páginas web para negocios · © {year}</p>
  </div>
</footer>
