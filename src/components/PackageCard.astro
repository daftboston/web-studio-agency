---
import type { Package } from "../data/packages";
import WhatsAppButton from "./WhatsAppButton.astro";
interface Props { pkg: Package; compact?: boolean; index?: number }
const { pkg, compact = false, index = 0 } = Astro.props;
const shown = compact ? [] : pkg.incluye.slice(0, 8);
const rest = compact ? [] : pkg.incluye.slice(8);
---
<article
  id={compact ? undefined : pkg.id}
  class:list={["card-package h-full scroll-mt-24", compact && !pkg.recommended && "bg-canvas"]}
  data-recommended={pkg.recommended ? "" : undefined}
  data-reveal
  style={`--reveal-i:${index}`}
  aria-labelledby={`pkg-${pkg.id}${compact ? "-c" : ""}`}
>
  <div class="flex min-h-7 items-center justify-between gap-3">
    <span class="text-micro text-ink-tertiary">{pkg.step}</span>
    {pkg.recommended && <span class="chip chip-accent">Recomendado</span>}
  </div>
  <div>
    <h3 id={`pkg-${pkg.id}${compact ? "-c" : ""}`} class="text-title text-ink">{pkg.name}</h3>
    <p class="mt-2 text-lead text-ink-secondary">{pkg.promise}</p>
  </div>
  <p class="text-caption text-ink-secondary"><span class="font-semibold text-ink">Ideal para:</span> {pkg.idealPara.join(" · ")}</p>

  {!compact && (
    <div>
      <p class="mb-3 text-caption font-semibold text-ink">{pkg.incluyePrefix ?? "Incluye:"}</p>
      <ul class="check-list space-y-2 text-body text-ink" role="list">
        {shown.map((item) => <li>{item}</li>)}
      </ul>
      {rest.length > 0 && (
        <details class="mt-3 group">
          <summary class="link-more cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <span class="group-open:hidden">Ver todo ({rest.length} más)</span><span class="hidden group-open:inline">Ver menos</span>
          </summary>
          <ul class="check-list mt-3 space-y-2 text-body text-ink" role="list">
            {rest.map((item) => <li>{item}</li>)}
          </ul>
        </details>
      )}
    </div>
  )}

  <div class="mt-auto pt-2">
    {compact ? (
      <a href={`/paquetes/#${pkg.id}`} class="link-more">Ver detalle</a>
    ) : (
      <>
        <p class="mb-3 text-caption text-ink-tertiary">Precio: <span class="font-semibold text-ink-secondary">{pkg.price}</span></p>
        <WhatsAppButton message={pkg.wa} label="Cotizar por WhatsApp" class="w-full" />
      </>
    )}
  </div>
</article>
