---
// Text wordmark until a real logo exists (spec §1): Inter 700, tight tracking.
interface Props { class?: string }
const { class: cls = "" } = Astro.props;
---
<a href="/" class:list={["brand-mark inline-flex items-center gap-2 text-[1.25rem] font-bold tracking-[-0.03em] text-ink", cls]} aria-label="Filmika, inicio">
  <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="var(--accent)"/><path d="M11 8h11v3.6h-7v3.4h6v3.6h-6V24h-4z" fill="var(--on-accent)"/></svg>
  <span>Filmika</span>
</a>
