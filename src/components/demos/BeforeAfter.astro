---
/** Demo interactiva: before/after slider for a property (empty apartment, then painted and furnished). Illustrative SVG only. */
---
<div class="ba relative select-none overflow-hidden rounded-tile bg-surface-2" style="--pos:50%" data-before-after>
  <!-- Antes: empty, unpainted apartment -->
  <svg viewBox="0 0 800 500" class="block h-auto w-full" role="img" aria-labelledby="ba-antes-t">
    <title id="ba-antes-t">Antes: sala de un apartamento vacía, sin pintar y con cajas (ilustración)</title>
    <rect width="800" height="500" fill="#cfccc4"/>
    <path d="M0 0h800v40L700 90H100L0 40z" fill="#bdb9b0"/>
    <path d="M0 380h800v120H0z" fill="#a8a69f"/>
    <path d="M0 380l100-30h600l100 30" fill="#b3b0a8"/>
    <rect x="100" y="90" width="600" height="260" fill="#c4c1b8"/>
    <rect x="470" y="130" width="170" height="150" fill="#e4e2dc" stroke="#8d8b85" stroke-width="8"/>
    <path d="M555 130v150M470 205h170" stroke="#8d8b85" stroke-width="6"/>
    <path d="M300 90v36" stroke="#55534e" stroke-width="3"/><circle cx="300" cy="134" r="9" fill="#e9e7e2" stroke="#55534e" stroke-width="3"/>
    <g fill="#a8916b"><rect x="170" y="300" width="110" height="80"/><rect x="250" y="330" width="80" height="50"/></g>
    <path d="M170 318h110M250 346h80" stroke="#8a7350" stroke-width="5"/>
    <path d="M150 200l40 22M610 330l30-40M380 160l20 30" stroke="#a8a69f" stroke-width="4"/>
  </svg>

  <!-- Después (clipped): same room painted and furnished -->
  <div class="ba-after absolute inset-0" aria-hidden="false">
    <svg viewBox="0 0 800 500" class="block h-full w-full" role="img" aria-labelledby="ba-despues-t">
      <title id="ba-despues-t">Después: la misma sala pintada y amoblada, con sofá, tapete, lámpara y plantas (ilustración)</title>
      <rect width="800" height="500" fill="#f3ede4"/>
      <path d="M0 0h800v40L700 90H100L0 40z" fill="#e8e0d4"/>
      <path d="M0 380h800v120H0z" fill="#b98a5e"/>
      <path d="M0 380l100-30h600l100 30" fill="#c99a6c"/>
      <rect x="100" y="90" width="600" height="260" fill="#f7f2ea"/>
      <rect x="470" y="130" width="170" height="150" fill="#cfe3f5" stroke="#ffffff" stroke-width="8"/>
      <path d="M555 130v150M470 205h170" stroke="#ffffff" stroke-width="6"/>
      <rect x="455" y="122" width="34" height="170" fill="#3d3ad6" opacity=".85"/><rect x="621" y="122" width="34" height="170" fill="#3d3ad6" opacity=".85"/>
      <rect x="170" y="150" width="150" height="100" fill="#ffffff" stroke="#141413" stroke-width="6"/>
      <path d="M180 235l40-45 30 30 25-20 35 35z" fill="#3d3ad6" opacity=".7"/><circle cx="290" cy="178" r="12" fill="#fbbf24"/>
      <ellipse cx="380" cy="430" rx="250" ry="34" fill="#e8dccb"/>
      <rect x="200" y="300" width="300" height="70" rx="18" fill="#55534e"/>
      <rect x="215" y="268" width="270" height="50" rx="16" fill="#6e6c66"/>
      <rect x="185" y="300" width="40" height="80" rx="14" fill="#47453f"/><rect x="475" y="300" width="40" height="80" rx="14" fill="#47453f"/>
      <rect x="250" y="285" width="60" height="40" rx="10" fill="#fbbf24"/>
      <path d="M600 240v130" stroke="#141413" stroke-width="5"/><path d="M570 240h60l-12-40h-36z" fill="#fde68a"/>
      <rect x="585" y="370" width="30" height="8" fill="#141413"/>
      <rect x="85" y="330" width="40" height="50" fill="#f6f5f3" stroke="#a8a69f" stroke-width="3"/>
      <g fill="#5c8a4f"><ellipse cx="95" cy="300" rx="14" ry="34"/><ellipse cx="118" cy="306" rx="12" ry="30"/><ellipse cx="106" cy="290" rx="10" ry="36"/></g>
      <rect x="690" y="340" width="34" height="42" fill="#f6f5f3" stroke="#a8a69f" stroke-width="3"/>
      <g fill="#5c8a4f"><circle cx="707" cy="320" r="22"/></g>
    </svg>
  </div>

  <span class="pointer-events-none absolute left-4 top-4 rounded-full bg-[#141413]/80 px-3 py-1 text-micro text-white">Antes</span>
  <span class="pointer-events-none absolute right-4 top-4 rounded-full bg-[#141413]/80 px-3 py-1 text-micro text-white">Después</span>

  <div class="ba-handle pointer-events-none absolute inset-y-0 w-0.5 -translate-x-1/2 bg-white shadow-[0_0_0_1px_rgb(0_0_0/0.1)]" aria-hidden="true">
    <span class="absolute left-1/2 top-1/2 flex size-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white text-[#141413] shadow-float">
      <svg width="20" height="20" viewBox="0 0 20 20"><path d="M7 5l-4 5 4 5M13 5l4 5-4 5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </div>

  <label class="sr-only" for="ba-range">Mover para comparar antes y después</label>
  <input id="ba-range" type="range" min="0" max="100" value="50" class="ba-range absolute inset-0 h-full w-full cursor-ew-resize opacity-0" data-js-only />
</div>

<style>
  .ba-after { clip-path: inset(0 0 0 var(--pos)); }
  .ba-handle { left: var(--pos); }
  .ba-range:focus-visible ~ .ba-handle span, .ba:has(.ba-range:focus-visible) .ba-handle span { outline: 2px solid var(--focus); outline-offset: 2px; }
</style>

<script>
  import { onNear } from "../../scripts/lazy";
  onNear("[data-before-after]", (root) => {
    const range = root.querySelector<HTMLInputElement>("input[type=range]");
    if (!range) return;
    const set = () => {
      root.style.setProperty("--pos", `${range.value}%`);
      range.setAttribute("aria-valuetext", `${range.value}% antes, ${100 - Number(range.value)}% después`);
    };
    range.addEventListener("input", set);
    set();
  });
</script>
