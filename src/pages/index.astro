---
import Base from "../layouts/Base.astro";
import MaskTitle from "../components/MaskTitle.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import PackageCard from "../components/PackageCard.astro";
import BrowserFrame from "../components/BrowserFrame.astro";
import PhoneFrame from "../components/PhoneFrame.astro";
import CaseCard from "../components/CaseCard.astro";
import Faq from "../components/Faq.astro";
import PhoneCycler from "../components/demos/PhoneCycler.astro";
import { PACKAGES } from "../data/packages";
import { PLANS, PROCESS } from "../data/plans";
import { PROJECTS } from "../data/portfolio";
import { SERVICES } from "../data/services";
import { FAQ } from "../data/faq";
import { SITE, PRICES } from "../config";
---
<Base title="Filmika" description={SITE.defaultDescription} scenes>
  <!-- 1. Hero: statement headline rising out of masks, then a wide media panel that opens up on scroll -->
  <section class="overflow-x-clip pt-section-tight md:pt-section" data-scene="light" aria-labelledby="h-hero">
    <div class="container-wide">
      <p class="eyebrow rise-in mb-6">Filmika · Páginas web para negocios</p>
      <MaskTitle id="h-hero" class="text-hero text-ink" lines={["Tu negocio merece", "una página que", "trabaje por ti."]} />
      <div class="mt-8 grid gap-8 lg:mt-10 lg:grid-cols-12 lg:items-end lg:gap-grid">
        <p class="rise-in max-w-[34rem] text-lead text-ink-secondary lg:col-span-6" style="--d:250">Diseñamos páginas web claras, rápidas y conectadas a tu WhatsApp, para que tu negocio reciba más clientes.</p>
        <div class="rise-in flex flex-col items-stretch gap-4 sm:flex-row sm:items-center sm:gap-6 lg:col-span-6 lg:justify-end" style="--d:350">
          <WhatsAppButton />
          <a href="/portafolio/" class="link-more justify-center">Ver proyectos</a>
        </div>
      </div>
    </div>
    <div class="mt-12 px-2 md:mt-16 md:px-4">
      <div data-expand class="relative mx-auto max-w-[96rem] overflow-hidden rounded-[1.75rem] bg-surface-2 md:rounded-[2.5rem]">
        <div class="relative mx-auto max-w-[72rem] px-5 pb-[18%] pt-10 md:px-12 md:pb-[12%] md:pt-16">
          <BrowserFrame src={PROJECTS[0].image} alt={PROJECTS[0].alt} eager widths={[640, 960, 1280, 1600]} sizes="(min-width: 1152px) 1056px, 92vw" class="shadow-lift" />
          <div class="absolute bottom-6 right-4 w-[30%] max-w-[17rem] md:bottom-10 md:right-10 md:w-[24%]" data-parallax style="--depth:40">
            <PhoneFrame src={PROJECTS[1].phone.src} alt={PROJECTS[1].phone.alt} sizes="(min-width: 768px) 272px, 30vw" />
          </div>
        </div>
      </div>
      <p class="container-wide mt-4 text-caption text-ink-tertiary">Proyectos reales: TruePhone en el computador, Tesla Partes en el celular.</p>
    </div>
  </section>

  <!-- 2. Servicios: short statement next to a visible, numbered list (Clay's intro + services pattern) -->
  <Section scene="light" labelledby="h-servicios">
    <div class="container-wide grid gap-stack lg:grid-cols-12 lg:gap-grid">
      <header class="lg:col-span-5" data-reveal>
        <p class="eyebrow mb-3">Servicios</p>
        <h2 id="h-servicios" class="text-display text-ink">Todo lo que tu página necesita, en un solo lugar.</h2>
        <p class="mt-5 max-w-text text-lead text-ink-secondary">Diseño, textos, publicación y soporte. Tú nos cuentas de tu negocio; nosotros nos encargamos del resto.</p>
        <p class="mt-6"><a href="/servicios/" class="link-more">Ver servicios</a></p>
      </header>
      <ol class="border-b border-line lg:col-span-6 lg:col-start-7" role="list">
        {SERVICES.map((s, i) => (
          <li class="grid grid-cols-[3rem_1fr] gap-x-2 border-t border-line py-6 md:py-7" data-reveal style={`--reveal-i:${Math.min(i, 4)}`}>
            <span class="pt-1 text-caption text-ink-tertiary tabular-nums" aria-hidden="true">{s.n}</span>
            <div>
              <h3 class="text-title text-ink"><a href={`/servicios/#${s.id}`} class="hover:text-accent">{s.name}</a></h3>
              <p class="mt-2 text-body text-ink-secondary">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <!-- 3. Trabajo destacado: staggered case cards -->
  <Section scene="warm" labelledby="h-trabajo">
    <div class="container-wide">
      <header class="mb-stack flex flex-col gap-4 md:flex-row md:items-end md:justify-between" data-reveal>
        <div>
          <p class="eyebrow mb-3">Portafolio</p>
          <h2 id="h-trabajo" class="text-display text-ink">Sitios que ya están trabajando.</h2>
        </div>
        <a href="/portafolio/" class="link-more">Ver los casos</a>
      </header>
      <div class="grid gap-x-grid gap-y-16 md:grid-cols-2">
        <CaseCard project={PROJECTS[0]} index={0} />
        <CaseCard project={PROJECTS[1]} index={1} class="md:mt-32" />
      </div>
    </div>
  </Section>

  <!-- 4. Diferenciador -->
  <Section scene="dark" labelledby="h-dif">
    <div class="container-wide grid gap-stack lg:grid-cols-12 lg:gap-grid">
      <h2 id="h-dif" class="text-display text-ink lg:col-span-7" data-reveal>Hablas directamente con quien diseña tu página.</h2>
      <div class="lg:col-span-4 lg:col-start-9 lg:pt-3" data-reveal style="--reveal-i:1">
        <p class="text-lead text-ink-secondary">Sin intermediarios ni cadenas de correos. El equipo de Filmika viene de la arquitectura, la mecánica y las ventas, así que entiende cómo funciona un negocio por dentro.</p>
        <p class="mt-5 text-body font-semibold text-ink">{SITE.experience}</p>
        <p class="mt-5"><a href="/nosotros/" class="link-more">Conoce a Filmika</a></p>
      </div>
    </div>
  </Section>

  <!-- 5. Lo que podemos hacer (Instrument-style showcase) -->
  <section class="overflow-x-clip pb-section-tight pt-section-tight" data-scene="accent" aria-labelledby="h-podemos">
    <div class="container-wide">
      <p class="label-rule"><span>Capacidades</span><span>Ejemplos para distintos tipos de negocio</span></p>
      <h2 id="h-podemos" class="mt-6 text-mega text-ink md:mt-10" data-scroll-words>
        <span>Lo</span> <span>que</span> <span>podemos</span> <span>hacer.</span>
      </h2>
      <p class="mt-8 max-w-text text-lead text-ink-secondary md:mt-12">Un portafolio muestra lo que ya hicimos. Aquí puedes probar lo que podemos construir para tu negocio.</p>
    </div>
    <div class="theme-accent panel-bleed mt-section-tight" data-band>
      <div class="container-wide grid items-center gap-12 py-section lg:grid-cols-12">
        <div class="order-2 lg:order-1 lg:col-span-6">
          <span class="chip-demo">Demo interactiva</span>
          <ol class="mt-6 border-b border-line" role="list">
            {[
              ["01", "Una página para cada tipo de negocio", "#demo-celular"],
              ["02", "Antes y después de un trabajo", "#demo-antes-despues"],
              ["03", "Catálogo que vende por WhatsApp", "#demo-catalogo"],
              ["04", "Agenda de citas en línea", "#demo-agenda"],
              ["05", "Movimiento al desplazarse", "#demo-movimiento"],
              ["06", "Rápida por defecto", "#demo-velocidad"],
            ].map(([n, t, href], i) => (
              <li class="border-t border-line" data-reveal style={`--reveal-i:${Math.min(i, 4)}`}>
                <a href={`/capacidades/${href}`} class="group flex items-baseline gap-5 py-4 md:py-5">
                  <span class="text-caption text-ink-tertiary tabular-nums">{n}</span>
                  <span class="text-title text-ink transition-transform duration-(--duration-ui) ease-standard group-hover:translate-x-1.5">{t}</span>
                  <span class="ml-auto text-title text-ink-tertiary transition-transform duration-(--duration-ui) ease-standard group-hover:translate-x-1" aria-hidden="true">›</span>
                </a>
              </li>
            ))}
          </ol>
          <p class="mt-8"><a href="/capacidades/" class="btn btn-primary">Probar las demos</a></p>
        </div>
        <div class="order-1 lg:order-2 lg:col-span-6">
          <PhoneCycler />
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Paquetes preview -->
  <Section scene="warm" labelledby="h-paq">
    <div class="container-content">
      <SectionHeader id="h-paq" eyebrow="Paquetes" title="Elige cómo empezar." lead="Tres puntos de partida, según lo que necesita tu negocio. Te ayudamos a decidir por WhatsApp." />
      <div class="-mx-gutter flex snap-x snap-mandatory gap-grid overflow-x-auto px-gutter pb-2 pt-1 lg:mx-0 lg:grid lg:grid-cols-3 lg:overflow-visible lg:px-0">
        {PACKAGES.map((p, i) => (
          <div class="w-[85%] shrink-0 snap-center sm:w-[60%] lg:w-auto">
            <PackageCard pkg={p} compact index={i} />
          </div>
        ))}
      </div>
      <p class="mx-auto mt-stack max-w-text text-center text-caption text-ink-secondary">{PRICES.includes} {PRICES.note}</p>
      <p class="mt-5 text-center"><a href="/paquetes/" class="link-more">Ver los paquetes</a></p>
    </div>
  </Section>

  <!-- 7. Planes (dark band) -->
  <Section scene="dark" labelledby="h-planes">
    <div class="container-content">
      <header class="mx-auto mb-stack max-w-text text-center" data-reveal>
        <p class="eyebrow mb-3">Planes</p>
        <h2 id="h-planes" class="text-display text-ink">No desaparecemos después del lanzamiento.</h2>
        <p class="mt-5 text-lead text-ink-secondary">Cada mes cuidamos tu página para que siga trabajando por ti.</p>
      </header>
      <ol class="relative grid gap-8 border-l border-line pl-6 lg:grid-cols-3 lg:gap-grid lg:border-l-0 lg:pl-0" role="list">
        {PLANS.map((plan, i) => (
          <li class="relative lg:rounded-card lg:bg-surface lg:p-8" data-reveal style={`--reveal-i:${i}`}>
            <span class="absolute -left-[1.85rem] top-1.5 size-2.5 rounded-full bg-accent lg:hidden" aria-hidden="true"></span>
            <p class="text-caption text-ink-tertiary">{plan.label}</p>
            <h3 class="mt-1 text-title text-ink">{plan.name}</h3>
            <p class="mt-2 text-body text-ink-secondary">{plan.short}</p>
            {i < PLANS.length - 1 && <span class="absolute -right-[0.95rem] top-1/2 hidden -translate-y-1/2 text-[1.5rem] text-ink-tertiary lg:block" aria-hidden="true">›</span>}
          </li>
        ))}
      </ol>
      <div class="mt-stack flex flex-col items-center gap-5 sm:flex-row sm:justify-center sm:gap-6" data-reveal>
        <WhatsAppButton message="planes" label="Pregunta por los planes" class="w-full sm:w-auto" />
        <a href="/planes/" class="link-more">Ver planes</a>
      </div>
    </div>
  </Section>

  <!-- 8. Proceso -->
  <Section scene="light" labelledby="h-proceso">
    <div class="container-wide">
      <header class="mb-stack flex flex-col gap-4 md:flex-row md:items-end md:justify-between" data-reveal>
        <div>
          <p class="eyebrow mb-3">Proceso</p>
          <h2 id="h-proceso" class="text-display text-ink">Así trabajamos.</h2>
        </div>
        <a href="/proceso/" class="link-more">Ver el proceso</a>
      </header>
      <ol class="grid gap-10 border-t border-line pt-8 md:grid-cols-2 lg:grid-cols-4 lg:gap-grid" role="list">
        {PROCESS.map((s, i) => (
          <li data-reveal style={`--reveal-i:${i}`}>
            <span class="block text-caption text-ink-tertiary tabular-nums" aria-hidden="true">{s.n}</span>
            <h3 class="mt-3 text-title text-ink"><span class="sr-only">Paso {s.n}: </span>{s.title}</h3>
            <p class="mt-2 text-body text-ink-secondary">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <!-- 9. FAQ -->
  <Section scene="warm" labelledby="h-faq">
    <div class="container-wide">
      <Faq items={FAQ} />
    </div>
  </Section>
</Base>
