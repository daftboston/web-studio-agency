---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { PACKAGES } from "../data/packages";
import { SITE, PRICES, DEMO_URLS, waLink, type WaMessageKey } from "../config";
import truephone from "../assets/portfolio/truephone.webp";
import teslaCo from "../assets/demos/tesla-partes-co-desktop.webp";
import vet from "../assets/demos/vet-desktop.webp";
import dental from "../assets/demos/dental-desktop.webp";
import optica from "../assets/demos/optica-desktop.webp";

const planWa: Record<string, WaMessageKey> = { landing: "planLanding", "pagina-web": "planPaginaWeb", catalogo: "planCatalogo" };
const clean = (s: string) => s.replace(" o inmuebles", "");

const works = [
  { name: "TruePhone", line: "Marketplace de iPhones usados con revisión de cada anuncio.", img: truephone, alt: "Página de inicio de TruePhone", url: "https://www.truephone.shop/", domain: "truephone.shop", demo: false },
  // Tesla Partes CO: screenshot from a local build of daftboston/tesla-partes-co. Live URL pending → no link.
  { name: "Tesla Partes CO", line: "Tienda en línea de partes compatibles para Model 3 y Model Y.", note: "Tienda independiente, no afiliada a Tesla, Inc.", img: teslaCo, alt: "Página de inicio de Tesla Partes CO: selector de Model 3 y Model Y", url: null, domain: "tesla-partes-co", demo: false, pending: "Enlace disponible pronto" },
  { name: "Veterinaria", line: "Servicios, horarios y citas por WhatsApp.", img: vet, alt: "Demo de página web para una veterinaria", url: DEMO_URLS.vet, domain: "demo · veterinaria", demo: true },
  { name: "Clínica dental", line: "Tratamientos, ubicación y agenda por WhatsApp.", img: dental, alt: "Demo de página web para una clínica dental", url: DEMO_URLS.dental, domain: "demo · clínica dental", demo: true },
  { name: "Óptica", line: "Catálogo de monturas con pedido por WhatsApp.", img: optica, alt: "Demo de catálogo en línea para una óptica", url: DEMO_URLS.optica, domain: "demo · óptica", demo: true },
];

const steps = [
  { t: "Diagnóstico", d: "Hablamos por WhatsApp de tu negocio, tus clientes y lo que necesitas." },
  { t: "Boceto gratis", d: "Te mostramos cómo se vería tu página antes de que pagues." },
  { t: "Construcción", d: "Diseñamos y escribimos tu página, y la ajustamos contigo." },
  { t: "Lanzamiento + Digital Care", d: "La publicamos con tu dominio y la cuidamos cada mes." },
];

const growth = ["SEO local para aparecer cuando te buscan", "Anuncios en Google y Meta"];
const auto = [
  "Cada consulta capturada y respondida al instante",
  "Respuestas automáticas por WhatsApp",
  "Reservas en línea con recordatorios",
  "Solicitudes de reseñas en Google",
  "Todos tus clientes organizados en un solo lugar",
];

const why = [
  { t: "Entrega rápida", d: "Tu página lista en pocas semanas, sin procesos eternos.", i: "M13 2 3 14h9l-1 8 10-12h-9l1-8z" },
  { t: "Conectada a tu WhatsApp", d: "Cada botón lleva a una conversación contigo.", i: "M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.5 8.5 0 1 1 21 11.5z" },
  { t: "El dominio es tuyo", d: "El nombre de tu página queda a nombre de tu negocio.", i: "M15 7a4 4 0 1 0-3.9 5L4 19v2h3v-2h2v-2h2l1.9-1.9A4 4 0 0 0 15 7z" },
  { t: "Soporte mensual (Digital Care)", d: "Cambios, copias de seguridad y ayuda cada mes.", i: "M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z" },
];
const trust = ["Más de 3 años de experiencia creando sitios web", "Atención directa por WhatsApp", "Soporte cada mes", "Sitios rápidos y fáciles de usar"];
const sparkle = "M12 3l1.9 5.6L19.5 10l-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.4z";
---
<Base title="Filmika" description={SITE.defaultDescription} darkHero hideFinalCta>
  <!-- 2. Hero (dark band, static glow) -->
  <section id="inicio" class="theme-dark hero-glow overflow-hidden bg-canvas py-section text-center" data-dark-hero aria-labelledby="h-hero">
    <div class="container-content">
      <p class="badge-pill animate-hero-in"><svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={sparkle} /></svg>Páginas web para negocios</p>
      <h1 id="h-hero" class="mx-auto mt-6 max-w-[16ch] text-hero text-ink animate-hero-in [animation-delay:80ms]">Tu negocio merece una página que <span class="accent-word">trabaje por ti.</span></h1>
      <p class="mx-auto mt-6 max-w-text text-lead text-ink-secondary animate-hero-in [animation-delay:160ms]">Diseñamos páginas web claras, rápidas y conectadas a tu WhatsApp, para que tu negocio reciba más clientes.</p>
      <div class="mt-9 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center animate-hero-in [animation-delay:240ms]">
        <WhatsAppButton label="Quiero mi página" />
        <a href="#planes" class="btn btn-dark-secondary">Ver planes</a>
      </div>
      <ul class="mx-auto mt-14 grid max-w-content grid-cols-2 gap-3 text-left md:grid-cols-4 animate-hero-in [animation-delay:320ms]" role="list">
        {trust.map((t) => (
          <li class="flex items-start gap-2.5 rounded-card-v2 border border-card-border bg-card-bg p-4 text-caption text-ink-secondary">
            <svg class="mt-0.5 size-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>{t}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. Trabajos -->
  <section id="trabajos" class="bg-canvas py-section" aria-labelledby="h-trabajos">
    <div class="container-wide">
      <header class="text-center" data-reveal>
        <p class="badge-pill">Trabajos</p>
        <h2 id="h-trabajos" class="mt-4 text-display text-ink">Trabajo <span class="accent-word">real</span></h2>
        <p class="mx-auto mt-4 max-w-text text-lead text-ink-secondary">Un proyecto en línea y ejemplos de lo que podemos hacer para tu negocio.</p>
      </header>
      <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3" role="list">
        {works.map((w, i) => {
          const Tag = w.url ? "a" : "div";
          return (
            <li data-reveal style={`--reveal-i:${i % 3}`}>
              <Tag {...(w.url ? { href: w.url, target: "_blank", rel: "noopener" } : {})} class="card-v2 group block h-full !p-4">
                <div class="browser-frame">
                  <div class="browser-frame__bar" aria-hidden="true"><span class="browser-frame__dot"></span><span class="browser-frame__dot"></span><span class="browser-frame__dot"></span><span class="browser-frame__url">{w.domain}</span></div>
                  <Picture src={w.img} alt={w.alt} formats={["avif", "webp"]} widths={[480, 768, 1024, 1440]} sizes="(min-width:1024px) 33vw, (min-width:768px) 50vw, 100vw" loading="lazy" decoding="async" class="browser-frame__shot" />
                </div>
                <div class="px-2 pb-2 pt-5">
                  <div class="flex items-center gap-2">
                    <h3 class="text-title text-ink">{w.name}</h3>
                    {w.demo && <span class="chip chip-outline">Demo</span>}
                  </div>
                  <p class="mt-1 text-caption text-ink-secondary">{w.line}</p>
                  {w.note && <p class="mt-1 text-micro text-ink-tertiary">{w.note}</p>}
                  <div class="mt-4 border-t border-card-border pt-3 text-caption font-medium">
                    {w.url ? <span class="text-accent">Ver sitio ↗</span> : <span class="text-ink-tertiary">{w.pending ?? "Demo: enlace disponible pronto"}</span>}
                  </div>
                </div>
              </Tag>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- 4. Cómo trabajamos -->
  <section id="proceso" class="bg-surface py-section" aria-labelledby="h-proceso">
    <div class="container-wide">
      <header class="text-center" data-reveal>
        <p class="badge-pill">Cómo trabajamos</p>
        <h2 id="h-proceso" class="mt-4 text-display text-ink">Cuatro pasos, <span class="accent-word">sin enredos</span></h2>
      </header>
      <ol class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4" role="list">
        {steps.map((s, i) => (
          <li class="card-v2" data-reveal style={`--reveal-i:${i}`}>
            <span class="text-display text-accent tabular-nums" aria-hidden="true">{i + 1}</span>
            <h3 class="mt-3 text-title text-ink">{s.t}</h3>
            <p class="mt-2 text-body text-ink-secondary">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5. Planes -->
  <section id="planes" class="bg-canvas py-section" aria-labelledby="h-planes">
    <div class="container-wide">
      <header class="text-center" data-reveal>
        <p class="badge-pill">Planes</p>
        <h2 id="h-planes" class="mt-4 text-display text-ink">Elige el plan para <span class="accent-word">tu negocio</span></h2>
        <p class="mx-auto mt-4 max-w-text text-lead text-ink-secondary">{PRICES.includes}</p>
      </header>
      <ul class="mx-auto mt-14 grid max-w-[36rem] gap-6 lg:max-w-none lg:grid-cols-3 lg:items-stretch" role="list">
        {PACKAGES.map((p, i) => (
          <li class="card-v2 relative flex flex-col" data-featured={p.recommended ? "" : undefined} data-reveal style={`--reveal-i:${i}`}>
            {p.recommended && <span class="chip chip-accent absolute -top-3.5 left-1/2 -translate-x-1/2">Más popular</span>}
            <h3 class:list={["text-title", p.recommended ? "text-accent" : "text-ink"]}>{p.name}</h3>
            <p class="mt-2 text-body text-ink-secondary">{clean(p.promise)}</p>
            <p class="mt-6 text-ink"><span class="text-[2rem] font-bold tracking-tight">{p.price.setup}</span> <span class="text-caption text-ink-secondary">pago inicial</span></p>
            <p class="text-caption text-ink-secondary">+ {p.price.monthly}/mes de Digital Care</p>
            <ul class="mt-6 space-y-2.5 border-t border-card-border pt-6 text-caption text-ink-secondary" role="list">
              {p.incluye.map((x) => (
                <li class="flex gap-2.5"><svg class="mt-0.5 size-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>{clean(x)}</li>
              ))}
            </ul>
            <a href={waLink(planWa[p.id])} target="_blank" rel="noopener" class:list={["btn mt-8 w-full", p.recommended ? "btn-accent" : "btn-secondary"]} data-wa-inline>Quiero este plan</a>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-center text-caption text-ink-tertiary">{PRICES.note}</p>
    </div>
  </section>

  <!-- 6. A medida -->
  <section id="servicios" class="bg-surface py-section-tight" aria-labelledby="h-medida">
    <div class="container-wide grid gap-10 lg:grid-cols-12 lg:items-start">
      <header class="lg:col-span-4" data-reveal>
        <p class="badge-pill">A medida</p>
        <h2 id="h-medida" class="mt-4 text-display text-ink">¿Necesitas algo <span class="accent-word">a medida?</span></h2>
        <p class="mt-4 text-lead text-ink-secondary">Cuando tu negocio necesita más que una página. Se cotiza según el proyecto.</p>
        <div class="mt-8"><WhatsAppButton message="aMedida" label="Cotizar por WhatsApp" /></div>
      </header>
      <div class="grid gap-5 md:grid-cols-2 lg:col-span-8">
        <article class="card-v2" data-reveal>
          <h3 class="text-title text-ink">Growth</h3>
          <p class="mt-2 text-body text-ink-secondary">Más personas encontrando tu negocio.</p>
          <ul class="mt-5 space-y-2.5 text-caption text-ink-secondary" role="list">{growth.map((x) => <li class="flex gap-2.5"><span class="text-accent" aria-hidden="true">✓</span>{x}</li>)}</ul>
          <p class="mt-6 text-caption font-semibold text-ink">Se cotiza</p>
        </article>
        <article class="card-v2" data-reveal style="--reveal-i:1">
          <h3 class="text-title text-ink">Automatización de clientes</h3>
          <p class="mt-2 text-body text-ink-secondary">Que ningún cliente se quede sin respuesta.</p>
          <ul class="mt-5 space-y-2.5 text-caption text-ink-secondary" role="list">{auto.map((x) => <li class="flex gap-2.5"><span class="text-accent" aria-hidden="true">✓</span>{x}</li>)}</ul>
          <p class="mt-6 text-caption font-semibold text-ink">Se cotiza</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 7. Por qué Filmika -->
  <section class="bg-canvas py-section" aria-labelledby="h-porque">
    <div class="container-wide">
      <header class="text-center" data-reveal>
        <p class="badge-pill">Por qué Filmika</p>
        <h2 id="h-porque" class="mt-4 text-display text-ink">Una página que <span class="accent-word">sigue contigo</span></h2>
      </header>
      <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4" role="list">
        {why.map((w, i) => (
          <li class="card-v2 hover:border-accent/40" data-reveal style={`--reveal-i:${i}`}>
            <span class="grid size-10 place-items-center rounded-xl bg-accent-tint text-accent"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d={w.i} /></svg></span>
            <h3 class="mt-5 text-title text-ink">{w.t}</h3>
            <p class="mt-2 text-body text-ink-secondary">{w.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 8. Final CTA band (dark) -->
  <section id="contacto" class="theme-dark hero-glow overflow-hidden bg-canvas py-section text-center" aria-labelledby="h-cta">
    <div class="container-content" data-reveal>
      <p class="badge-pill">Contacto</p>
      <h2 id="h-cta" class="mx-auto mt-5 max-w-[18ch] text-display text-ink">Hablemos de <span class="accent-word">tu página</span></h2>
      <p class="mx-auto mt-5 max-w-text text-lead text-ink-secondary">Cuéntanos de tu negocio y te respondemos por WhatsApp con una recomendación clara, sin compromiso.</p>
      <div class="mt-9 flex justify-center"><WhatsAppButton label="Quiero mi página" /></div>
    </div>
  </section>
</Base>
