---
import Base from "../layouts/Base.astro";
import MaskTitle from "../components/MaskTitle.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import BrowserFrame from "../components/BrowserFrame.astro";
import PhoneFrame from "../components/PhoneFrame.astro";
import DemoTile from "../components/DemoTile.astro";
import { PROJECTS, DEMOS } from "../data/portfolio";
const tones = ["theme-dark", "bg-surface-2"] as const;
/** Page background per case: TruePhone on near-black, Tesla Partes back on light. */
const scenesByCase = ["dark", "light"] as const;
---
<Base
  title="Portafolio"
  scenes
  description="Casos reales de Filmika: TruePhone, marketplace de iPhones usados con revisión de cada anuncio, y Tesla Partes, e-commerce de partes compatibles con Tesla en Colombia."
>
  <section class="overflow-x-clip pb-section-tight pt-section" data-scene="light" aria-labelledby="h-port">
    <div class="container-wide">
      <p class="eyebrow rise-in mb-6">Portafolio</p>
      <MaskTitle id="h-port" class="text-display text-ink" lines={["Sitios que ya", "están trabajando."]} />
      <div class="mt-8 grid gap-6 lg:grid-cols-12 lg:gap-grid">
        <p class="rise-in max-w-text text-lead text-ink-secondary lg:col-span-6" style="--d:250">Cada proyecto empezó con un negocio real y una pregunta: ¿qué necesita ver un cliente para confiar y escribir?</p>
        <nav class="rise-in lg:col-span-5 lg:col-start-8" style="--d:350" aria-label="Casos en esta página">
          <ul class="flex flex-wrap gap-2" role="list">
            {PROJECTS.map((p) => <li><a href={`#${p.id}`} class="chip-toggle">{p.name}</a></li>)}
            <li><a href="#ejemplos" class="chip-toggle">Ejemplos</a></li>
          </ul>
        </nav>
      </div>
    </div>
  </section>

  {PROJECTS.map((p, i) => (
    <article class="pb-section pt-section-tight" data-scene={scenesByCase[i % 2]} aria-labelledby={p.id}>
      <!-- Big media: full-bleed panel, browser frame settles flat, phone drifts on its own layer -->
      <div class:list={["panel-bleed relative", tones[i % 2]]} data-band>
        <div class="container-wide relative px-gutter pb-[16%] pt-section-tight md:pb-[10%] md:pt-section">
          <div class="mb-8 flex flex-wrap items-center justify-between gap-4 md:mb-12">
            <p class="text-micro tracking-[0.08em] text-ink-secondary uppercase">Caso {String(i + 1).padStart(2, "0")}</p>
            <ul class="flex flex-wrap gap-2" role="list" aria-label={`Etiquetas de ${p.name}`}>{p.tags.map((t) => <li class="tag">{t}</li>)}</ul>
          </div>
          <div class="mx-auto max-w-[76rem]" data-settle>
            <BrowserFrame src={p.image} alt={p.alt} widths={[640, 960, 1280, 1600]} sizes="(min-width: 1280px) 1216px, 92vw" class="shadow-lift" />
          </div>
          <div class:list={["absolute bottom-6 w-[30%] max-w-[16rem] md:bottom-10 md:w-[22%]", i % 2 ? "left-4 md:left-[6%]" : "right-4 md:right-[6%]"]} data-parallax style="--depth:60">
            <PhoneFrame src={p.phone.src} alt={p.phone.alt} sizes="(min-width: 768px) 256px, 30vw" />
          </div>
        </div>
      </div>

      <!-- Text row: name + outcome headline, then the brief next to what was built -->
      <div class="container-wide mt-12 grid gap-stack md:mt-16 lg:grid-cols-12 lg:gap-grid">
        <header class="lg:col-span-5" data-reveal>
          <h2 id={p.id} class="scroll-mt-24 text-display text-ink">{p.name}</h2>
          <p class="mt-4 text-lead text-ink">{p.headline}</p>
          <p class="mt-6">
            {p.url ? (
              <a href={p.url} target="_blank" rel="noopener" class="link-more">Ver el sitio<span class="sr-only"> {p.name} (se abre en una pestaña nueva)</span></a>
            ) : (
              <span class="text-caption text-ink-tertiary">Enlace disponible pronto</span>
            )}
          </p>
        </header>
        <div class="grid gap-10 md:grid-cols-2 lg:col-span-7 lg:gap-grid" data-reveal style="--reveal-i:1">
          <section aria-labelledby={`${p.id}-reto`}>
            <h3 id={`${p.id}-reto`} class="text-caption font-semibold text-ink-tertiary">El reto</h3>
            <p class="mt-3 text-body text-ink-secondary">{p.brief}</p>
          </section>
          <section aria-labelledby={`${p.id}-hicimos`}>
            <h3 id={`${p.id}-hicimos`} class="text-caption font-semibold text-ink-tertiary">Lo que construimos</h3>
            <ul class="check-list mt-3 space-y-2 text-body text-ink" role="list">{p.built.map((b) => <li>{b}</li>)}</ul>
          </section>
        </div>
      </div>
    </article>
  ))}

  <Section scene="warm" labelledby="h-demos" id="ejemplos" class="scroll-mt-12">
    <div class="container-content">
      <SectionHeader id="h-demos" eyebrow="Próximamente" title="Ejemplos para distintos tipos de negocio." lead="Así podría verse la página de tu negocio. Estamos preparando un ejemplo para cada forma de vender." />
      <div class="grid gap-grid md:grid-cols-3">
        {DEMOS.map((d, i) => (
          <div class="[&>article]:bg-canvas">
            <DemoTile niche={d.niche} name={d.name} text={d.text} index={i} />
          </div>
        ))}
      </div>
    </div>
  </Section>
</Base>
